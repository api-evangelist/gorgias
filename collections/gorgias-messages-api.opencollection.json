              }
            ]
          },
          "docs": "List messages for a ticket"
        },
        {
          "info": {
            "name": "Create a message on a ticket",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account}.gorgias.com/api/tickets/:id/messages",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a message on a ticket"
        }
      ]
    }
  ],
  "bundled": true
}